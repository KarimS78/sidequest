# Steam Web API key — get one at https://steamcommunity.com/dev/apikey
# Without this, /connect runs in demo mode with sample data.
STEAM_API_KEY=

# Supabase (not wired yet)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Gemini — powers the pick sentence, the roast and session notes.
# Get a key at https://aistudio.google.com/apikey
#
# OPTIONAL. Without it the app runs entirely on the local scoring engine
# (lib/recommend.ts, lib/roast.ts) — every feature still works, it just phrases
# things from templates instead. Spend is bounded in lib/ai-guard.ts: per-device
# and global daily caps, a token budget, a response cache and capped outputs.
GEMINI_API_KEY=

# Set to "false" to force the local engine even when a key is present.
# AI_ENABLED=true

# Community tags come from SteamSpy and the Steam storefront — keyless public
# endpoints, no configuration needed.
