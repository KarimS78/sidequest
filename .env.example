# Steam Web API key — get one at https://steamcommunity.com/dev/apikey
# Without this, /connect runs in demo mode with sample data.
STEAM_API_KEY=

# Supabase (not wired yet)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Recommendations and the roast run on a local scoring engine (lib/recommend.ts,
# lib/roast.ts) — no AI provider, no key. Community tags come from SteamSpy and
# the Steam storefront, both keyless public endpoints.
