{
  "name": "sidequest-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "SideQuest in-game overlay companion (Electron)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "make-icon": "node generate-icon.js",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "^25"
  },
  "build": {
    "appId": "com.karimsehil.sidequest",
    "productName": "SideQuest",
    "directories": {
      "output": "dist"
    },
    "files": [
      "*.js",
      "*.html",
      "assets/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.games"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game"
    }
  }
}
